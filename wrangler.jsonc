// Existing production Worker configuration, read from Cloudflare on 2026-10-20.
// Frontend assets are embedded in workers/worker.js; do not add an assets binding.
// Secret values remain in Cloudflare and must never be committed here.
{
  "previews": {
    "vars": {
      "PUBLIC_NOTIFICATIONS_ENABLED": "0",
      "PUBLIC_SCHEDULE_ENABLED": "0"
    },
    "kv_namespaces": [],
    "tail_consumers": []
  },
  "name": "hada-weather-web-v3",
  "account_id": "1a16d4f178bae474099aa23095030294",
  "main": "workers/rain-entry.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "base_dir": "workers",
  "find_additional_modules": true,
  "preserve_file_names": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ],
  "keep_vars": true,
  "vars": {
    "PUBLIC_NOTIFICATIONS_ENABLED": "1",
    "PUBLIC_SCHEDULE_ENABLED": "1"
  },
  "kv_namespaces": [
    {
      "binding": "PUBLIC_BULLETINS",
      "id": "101e4b5a321c415897f3e98b360d5af5"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "hada-weather.com/*",
      "zone_id": "e6bed25f68bfd6054bbf85eb5cd0163a"
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *",
      "*/15 * * * *"
    ]
  },
  "logpush": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "tail_consumers": []
}
