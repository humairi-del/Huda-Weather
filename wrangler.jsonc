{
  "name": "hada-rasid-central-preview",
  "account_id": "1a16d4f178bae474099aa23095030294",
  "main": "workers/rasid-entry.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "keep_vars": false,
  "build": {
    "command": "node scripts/sync-public-assets.mjs",
    "watch_dir": [
      "public",
      "scripts"
    ]
  },
  "vars": {
    "PUBLIC_NOTIFICATIONS_ENABLED": "0",
    "PUBLIC_SCHEDULE_ENABLED": "0",
    "NOTIFICATION_MODE": "simulate"
  },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "logpush": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "RASID_COORDINATOR",
        "class_name": "RasidCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rasid-sqlite-v1",
      "new_sqlite_classes": [
        "RasidCoordinator"
      ]
    }
  ]
}
