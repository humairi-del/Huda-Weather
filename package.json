{
  "name": "hada-weather-preview",
  "private": true,
  "scripts": {
    "test": "node --test *.test.mjs *.test.cjs",
    "build:map": "esbuild sea-map-render.mjs --bundle --format=esm --loader:.geojson=json --minify --outfile=sea-map-browser.mjs",
    "build:map-worker": "esbuild sea-map-worker.mjs --bundle --format=esm --minify --outfile=/tmp/hada-sea-map-worker.mjs"
  },
  "devDependencies": {
    "d3-contour": "4.0.2",
    "esbuild": "0.28.2"
  }
}
